# Server
BIND_ADDR=0.0.0.0:3000
DATABASE_URL=sqlite://rag.db?mode=rwc

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Set true when serving over HTTPS (marks the refresh cookie Secure)
COOKIE_SECURE=false
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

# LLM — OpenRouter or any OpenAI-compatible API
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Embeddings — defaults to the LLM base URL/key above. OpenRouter serves
# embeddings too; this free model works with no credits:
EMBEDDINGS_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# Or point at a different OpenAI-compatible provider:
#EMBEDDINGS_BASE_URL=https://api.openai.com/v1
#EMBEDDINGS_API_KEY=sk-...
#EMBEDDINGS_MODEL=text-embedding-3-small
